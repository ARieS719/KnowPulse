# 密钥模板：复制本文件为 .env 后填写（.env 已加入 .gitignore，不会入库）
SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# 生成模型与裁判模型（用于 RAG 回答生成、Golden Set 合成与评测）
LLM_MODEL=Qwen/Qwen2.5-72B-Instruct
JUDGE_MODEL=deepseek-ai/DeepSeek-V3

# 运行模式：MODE_A (本地嵌入+云端重排+API LLM) | MODE_B (Ollama 本地 LLM) | MODE_CLOUD (全 API)
RUN_MODE=MODE_A
LOCAL_EMBED_MODEL=BAAI/bge-m3
LOCAL_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Langfuse Cloud 免费版追踪配置（可选，未配置自动禁用）
LANGFUSE_PUBLIC_KEY=pk-lf-xxx
LANGFUSE_SECRET_KEY=sk-lf-xxx
LANGFUSE_HOST=https://cloud.langfuse.com
